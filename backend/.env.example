DATABASE_URL=postgresql://freep:freep@localhost:5432/freep_pipeline
LOG_LEVEL=INFO

KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/dreev
KEYCLOAK_API_AUDIENCE=freep-pipeline-api

# Client for POST /api/v1/auth/login (human review-UI login). Must have
# "Direct Access Grants" enabled in Keycloak. See README.md "Auth (Keycloak)".
KEYCLOAK_REVIEWER_CLIENT_ID=freep-reviewer-ui
KEYCLOAK_REVIEWER_CLIENT_SECRET=changeme

# Comma-separated list of origins the review UI is served from. Never "*".
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Only needed by the independent test client (AC15), never by the API
# itself. Get real values by creating a service-account client in the
# dreev realm (see runbook) — never commit real secrets here.
FREEP_TEST_CLIENT_ID=freep-test-client
FREEP_TEST_CLIENT_SECRET=changeme
API_BASE_URL=http://localhost:8000

# Local Ollama for LLM-assisted field extraction (profile/engagement/procedure).
# No API key needed — runs on your own machine.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Temporary stand-in for Ollama while a local model is being pulled — real
# secret, get your own key at console.groq.com, never commit a real value here.
GROQ_API_KEY=changeme
GROQ_MODEL=openai/gpt-oss-120b
