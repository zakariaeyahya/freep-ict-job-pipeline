# Local Docker Compose settings. Copy this file to .env and replace secrets.
DOCKERHUB_USERNAME=your-dockerhub-username
IMAGE_TAG=latest

POSTGRES_DB=freep_pipeline
POSTGRES_USER=freep
POSTGRES_PASSWORD=replace-with-a-local-password

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-local-password
KEYCLOAK_API_AUDIENCE=freep-pipeline-api
KEYCLOAK_REVIEWER_CLIENT_ID=freep-reviewer-ui
KEYCLOAK_REVIEWER_CLIENT_SECRET=replace-with-keycloak-client-secret

CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LOG_LEVEL=INFO