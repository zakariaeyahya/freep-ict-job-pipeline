# Local Docker Compose settings. Copy this file to .env and replace secrets.
DOCKERHUB_USERNAME=your-dockerhub-username
IMAGE_TAG=latest

POSTGRES_DB=freep_pipeline
POSTGRES_USER=freep
POSTGRES_PASSWORD=replace-with-a-local-password

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-local-password
KEYCLOAK_API_AUDIENCE=freep-pipeline-api
KEYCLOAK_REVIEWER_CLIENT_ID=freep-reviewer-ui
# The dreev realm/clients ship pre-built in docker/keycloak/dreev-realm.json
# and import automatically on first Keycloak startup (no manual admin
# console setup needed, on this machine or on Hostinger). These two secrets
# and the reviewer credentials below are pushed into that already-imported
# realm once by the keycloak-init service (docker/keycloak/init-secrets.sh) —
# pick any strong values here, they are never read back from Keycloak.
KEYCLOAK_REVIEWER_CLIENT_SECRET=replace-with-a-strong-secret
FREEP_TEST_CLIENT_SECRET=replace-with-a-strong-secret
REVIEWER_USERNAME=reviewer
REVIEWER_PASSWORD=replace-with-a-strong-password
REVIEWER_EMAIL=reviewer@example.com
REVIEWER_FIRST_NAME=Freep
REVIEWER_LAST_NAME=Reviewer

CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Caddy reverse proxy (docker/caddy/Caddyfile) — the domains it requests
# HTTPS certificates for via Let's Encrypt. Leave as localhost/api.localhost
# for local development (Caddy then serves plain HTTP on localhost, no
# certificate needed); set to your real domains in production.
FRONTEND_DOMAIN=localhost
API_DOMAIN=api.localhost
AUTH_DOMAIN=auth.localhost

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LOG_LEVEL=INFO